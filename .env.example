# =============================================================================
# Ana Morrison Website — Environment Variables (example / template)
#
# Este archivo documenta los nombres de variables usadas por la aplicación.
# NUNCA contiene valores reales. Los valores se configuran directamente en
# Vercel → Project Settings → Environment Variables (scopes Preview + Production
# + Development según corresponda). NO se commitean valores reales a Git.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — REQUERIDO (ya existente en el proyecto)
# app.supabase.com → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Consentimiento y analítica (P3 — PR #2)
# -----------------------------------------------------------------------------
# Versión de la política de cookies. Al cambiar → invalida cookies existentes
# y obliga al visitante a re-consentir. Formato libre corto (v1.0, v1.1, ...).
NEXT_PUBLIC_CONSENT_VERSION=v1.0

# Kill-switch global de analítica. Fail-closed por default.
# Solo cargará GA4 si TODAS las condiciones se cumplen simultáneamente:
#   1) NEXT_PUBLIC_ANALYTICS_ENABLED === "true"
#   2) NEXT_PUBLIC_GA_ID definido
#   3) Usuario aceptó consentimiento analítico
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Salt secreto para hashear IPs antes de almacenarlas (consents,
# lead_magnets_downloads, rate_limit_buckets). Sin este salt, ip_hash queda
# como null (fail-safe: mejor perder telemetría que exponer IP en claro).
# Generar con: openssl rand -hex 32
CONSENT_IP_HASH_SALT=

# -----------------------------------------------------------------------------
# Resend — OPCIONAL (email transaccional)
# Sin estas vars: los formularios siguen guardando el lead en Supabase, pero
# no envían email al usuario ni notificación interna. email_confirmation_status
# queda como 'skipped'. Ningún lead se pierde.
#
# Antes de activar: verifica el dominio anamorrison.com en resend.com
# (ver src/lib/email/README.md para pasos DNS).
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Formato: "Ana Morrison <noreply@anamorrison.com>" (dominio debe estar verificado)
RESEND_FROM_EMAIL=
# Destino de notificación interna cada vez que llega un lead
CONTACT_NOTIFICATION_EMAIL=

# -----------------------------------------------------------------------------
# Google Analytics 4 — OPCIONAL
# Formato: G-XXXXXXXXXX
# Solo carga si NEXT_PUBLIC_ANALYTICS_ENABLED=true Y consent analytics=true
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=

# Google Search Console verification (opcional)
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# -----------------------------------------------------------------------------
# Site URL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://anamorrison.com

# -----------------------------------------------------------------------------
# PR Auto-Pilot (feature existente — Anthropic + Supabase compartidos)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
PR_AUTH_SECRET=
PR_AUTOPILOT_WEBHOOK_SECRET=

# =============================================================================
# Variables PREPARADAS · NO consumidas en PR #2 · quedan aquí solo como
# referencia documental para PRs posteriores. Configurar solo cuando se
# active el PR correspondiente.
# =============================================================================

# HubSpot CRM — PR #5. Sin estas vars, sync HubSpot queda deshabilitado y
# los leads siguen guardándose normalmente en Supabase con
# hubspot_sync_status='disabled'.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# Cron secret para /api/cron/* — PR #5
CRON_SECRET=

# Meta Pixel — pendiente decisión de activación.
# En PR #2 no se importa ningún script de Meta aunque esta var esté definida.
NEXT_PUBLIC_META_PIXEL_ID=
